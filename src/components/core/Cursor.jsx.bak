import { useState, useEffect } from "react";
import CursorNormal from '../../assets/cursor.png';
import styled from 'styled-components';

const CursorWrapper = styled.div.attrs(props => ({
  style: {
    transform: `translateX(${props.$x}px) translateY(${props.$y}px) scale(2) rotate(${props.$angle}deg)`,
    backgroundImage: `url(${CursorNormal})`,
  }
}))`
  position: fixed;
  top: 0;
  left: 0;
  width: 50px;
  height: 50px;
  pointer-events: none;
  z-index: 10000;
  transform-origin: calc(50% -9px) calc(50% + 4px);

  background-repeat: no-repeat;
  background-position: center center;
  background-size: contain;
  will-change: transform;
  user-select: none;
`;

const Cursor = () => {
  const originDeg = 180; // -4 15
  const maxDeg = 210; // -26 18
  const minDeg = 85; // 12 - 48
  const [position, setPosition] = useState({ x: 0, y: 0 });
  const [isPointer, setPointer] = useState(false);
  const [angle, setAngle] = useState(minDeg); // 初始角度
  const [offset, setOffset] = useState({ x: 12, y: -48 });

  useEffect(() => {
    // 重新计算位置
    const newPosition = {
      x: position.x + offset.x,
      y: position.y + offset.y
    };
    console.log(offset.x);
    // setPosition(newPosition);
  }, [offset]);

  useEffect(() => {
    let lastY = 0;
    const handleMouseMove = (e) => {
      const correctedX = e.clientX + offset.x;
      const correctedY = e.clientY + offset.y;
      setPosition({ x: correctedX, y: correctedY });

      const deltaY = e.clientY - lastY;
      // setAngle((prevAngle) => {
      //   let newAngle = prevAngle;
      //   const rate = 0.4
       
      //   if (deltaY < 0) {
      //     newAngle = Math.min(newAngle + rate, maxDeg); 
      //   } else if (deltaY > 0) {
      //     newAngle = Math.max(newAngle - rate, minDeg);
      //   }
      //   const tanValue = Math.tan((newAngle + 90) * (Math.PI / 180)); // 换算为弧度
      //   const tranxlateX = deltaY / tanValue;
      //   if (tranxlateX !== 0) {
      //   console.log(tranxlateX);
      //     setOffset({
      //       x: tranxlateX,
      //       y: offset.y
      //     });
      //   }
       
      //   return newAngle;
      // });

      lastY = e.clientY;
    };

    const handleMouseOver = (e) => {
      if (e.target.classList.contains('m-pointer') || (e.target.parentNode && e.target.parentNode?.classList?.contains('m-pointer'))) {
        setPointer(true);
      } else {
        setPointer(false);
      }
    };

    window.addEventListener('mousemove', handleMouseMove);
    window.addEventListener('mouseover', handleMouseOver);

    return () => {
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('mouseover', handleMouseOver);
    };
  }, []); // 将 offset 作为依赖项传入 useEffect

  return (
    <CursorWrapper id="cursor" $x={position.x} $y={position.y} $pointer={isPointer ? 1 : 0} $angle={angle} />
  );
};

export default Cursor;
